# Claude Code — personal settings and transient change-control flag
.claude/settings.local.json
.claude/architecture-amendment.flag

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

__pycache__/
*.py[cod]
.pytest_cache/

# S1 model-checking — fetched pinned TLC jar (tools/verify/fetch-tla2tools.sh)
tools/verify/bin/
# TLC scratch state directories
models/**/states/
# TLC scratch from a repo-root invocation (runner now uses unique -metadir)
/states/

# B8 release-pipeline working directory (workflows and local dry-runs)
release-work/

# Track F — the canonical client at app/ (10 §10.1). The pnpm store and build
# output are derived; the lockfile is NOT ignored — 12 §1.1 installs from it
# with --frozen-lockfile, and INV-FE-10's two-environment gate depends on it.
app/node_modules/
app/**/node_modules/
app/dist/
app/**/dist/
app/**/*.tsbuildinfo
app/src-tauri/target/
app/native/**/build/
