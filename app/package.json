{
  "name": "@bleavit/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": ">=10.23.0 <11"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "depcruise": "depcruise packages src --config .dependency-cruiser.cjs",
    "test:firewall": "node --test tests/firewall/*.test.js",
    "test:protocol": "node --test tests/protocol/*.test.js",
    "test": "pnpm run test:firewall && pnpm run test:protocol && pnpm run test:mock-runtime && pnpm run check:casts && pnpm run depcruise:witness",
    "depcruise:witness": "depcruise tests/depcruise-witness --config tests/depcruise-witness/.dependency-cruiser.cjs --output-type err && (echo 'WITNESS DID NOT FIRE — the rule set is vacuous' && exit 1) || echo 'witness fired: rules are live'",
    "check:casts": "node tools/check-finalized-casts.mjs",
    "descriptors:generate": "papi generate --config .papi/polkadot-api.json",
    "test:mock-runtime": "node --test tests/mock-runtime/*.test.js",
    "descriptors:check": "node tools/check-descriptor-drift.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "17.0.1",
    "esbuild": "0.28.1",
    "polkadot-api": "2.1.8",
    "typescript": "5.9.3"
  }
}
