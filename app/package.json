{
  "name": "@bleavit/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": ">=10.23.0 <11"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "depcruise": "depcruise packages src --config .dependency-cruiser.cjs",
    "test:firewall": "node --test tests/firewall/*.test.js",
    "test:protocol": "node --test tests/protocol/*.test.js",
    "test": "pnpm run test:firewall && pnpm run test:ui && pnpm run test:screens && pnpm run test:providers && pnpm run test:protocol && pnpm run test:mock-runtime && pnpm run test:chain-client && pnpm run test:descriptors && pnpm run test:tx && pnpm run test:verify && pnpm run test:local-index && pnpm run test:intents && pnpm run test:contexts && pnpm run schemas:check && pnpm run skills:check && pnpm run test:receipts && pnpm run test:llm-handoff && pnpm run test:release && pnpm run check:handoff-network && pnpm run check:handoff-network:witness && pnpm run check:handoff-emitted && pnpm run check:above-fold && pnpm run check:handoff-emitted:witness && pnpm run check:chain-literals && pnpm run check:chain-literals:witness && pnpm run check:render-provenance && pnpm run check:render-provenance:witness && pnpm run check:no-html-sinks && pnpm run check:no-html-sinks:witness && pnpm run check:casts && pnpm run surface:check && pnpm run foreign:check && pnpm run check:budget && pnpm run depcruise:witness",
    "depcruise:witness": "depcruise tests/depcruise-witness --config tests/depcruise-witness/.dependency-cruiser.cjs --output-type err && (echo 'WITNESS DID NOT FIRE \u2014 the rule set is vacuous' && exit 1) || echo 'witness fired: rules are live'",
    "check:casts": "node tools/check-finalized-casts.mjs",
    "descriptors:generate": "node tools/check-descriptor-drift.mjs --update",
    "test:mock-runtime": "node --test tests/mock-runtime/*.test.js",
    "descriptors:check": "node tools/check-descriptor-drift.mjs",
    "foreign:check": "node tools/check-foreign-feed.mjs",
    "test:chain-client": "node --test tests/chain-client/*.test.js",
    "surface:generate": "node tools/generate-critical-surface.mjs",
    "surface:check": "node tools/generate-critical-surface.mjs --check",
    "test:descriptors": "node --test tests/descriptors/*.test.js",
    "check:budget": "node tools/check-smoldot-budget.mjs",
    "test:tx": "node --test tests/transaction-builder/*.test.js",
    "test:verify": "node --test tests/verify/*.test.js",
    "test:local-index": "node --test tests/local-index/*.test.js",
    "test:intents": "node --test tests/intents/*.test.js",
    "test:contexts": "node --test tests/contexts/*.test.js",
    "test:receipts": "node --test tests/receipts/*.test.js",
    "check:handoff-network": "node tools/check-handoff-network.mjs",
    "check:handoff-network:witness": "node tools/check-handoff-network.mjs --witness",
    "test:release": "node --test --test-concurrency=1 tests/release/*.test.js",
    "check:chain-literals": "node tools/check-chain-literals.mjs",
    "check:chain-literals:witness": "node tools/check-chain-literals.mjs --witness",
    "check:no-html-sinks": "node tools/check-no-html-sinks.mjs",
    "check:no-html-sinks:witness": "node tools/check-no-html-sinks.mjs --witness",
    "check:render-provenance": "node tools/check-render-provenance.mjs",
    "check:render-provenance:witness": "node tools/check-render-provenance.mjs --witness",
    "release:build": "node tools/release/build.mjs",
    "release:check": "node tools/release/build.mjs --check",
    "signers:audit": "node tools/verify-release/cli.mjs signers audit",
    "test:llm-handoff": "node --test tests/llm-handoff/*.test.js",
    "schemas:generate": "node tools/generate-schemas.mjs --write",
    "schemas:check": "node tools/generate-schemas.mjs",
    "skills:generate": "node tools/generate-skill-examples.mjs --write && node tools/generate-skill-instructions.mjs --write",
    "skills:check": "node tools/generate-skill-examples.mjs && node tools/generate-skill-instructions.mjs",
    "check:handoff-emitted": "node tools/check-handoff-emitted-imports.mjs",
    "check:handoff-emitted:witness": "node tools/check-handoff-emitted-imports.mjs --witness",
    "test:ui": "node --test tests/ui/*.test.js",
    "test:screens": "node --test tests/screens/*.test.js",
    "test:providers": "node --test tests/providers/*.test.js",
    "check:above-fold": "node tools/check-above-fold-facts.mjs"
  },
  "devDependencies": {
    "@polkadot-api/substrate-bindings": "0.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dependency-cruiser": "17.0.1",
    "esbuild": "0.28.1",
    "polkadot-api": "2.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  }
}
