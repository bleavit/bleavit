{
  "name": "@bleavit/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": ">=10.23.0 <11"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "depcruise": "depcruise packages src src-tauri tools/desktop --config .dependency-cruiser.mjs",
    "test:firewall": "node tools/run-suite.ts \"tests/firewall/*.test.{js,ts}\"",
    "test:protocol": "node tools/run-suite.ts \"tests/protocol/*.test.{js,ts}\"",
    "test": "pnpm run check:types && pnpm run test:firewall && pnpm run test:ui && pnpm run test:screens && pnpm run test:providers && pnpm run test:snapshot-tool && pnpm run test:platform && pnpm run test:protocol && pnpm run test:mock-runtime && pnpm run test:chain-client && pnpm run test:descriptors && pnpm run test:tx && pnpm run test:verify && pnpm run test:local-index && pnpm run test:analysis && pnpm run test:intents && pnpm run test:contexts && pnpm run schemas:check && pnpm run skills:check && pnpm run test:receipts && pnpm run test:llm-handoff && pnpm run test:release && pnpm run check:handoff-network && pnpm run check:handoff-network:witness && pnpm run check:handoff-emitted && pnpm run check:above-fold && pnpm run check:handoff-emitted:witness && pnpm run check:chain-literals && pnpm run check:chain-literals:witness && pnpm run check:render-provenance && pnpm run check:render-provenance:witness && pnpm run check:no-html-sinks && pnpm run check:no-html-sinks:witness && pnpm run check:casts && pnpm run check:casts:witness && pnpm run surface:check && pnpm run foreign:check && pnpm run check:budget && pnpm run depcruise:witness && pnpm run check:smoldot-surface && pnpm run check:smoldot-surface:witness && pnpm run test:budgets && pnpm run check:provenance-mints && pnpm run check:provenance-mints:witness && pnpm run check:covered-history && pnpm run check:covered-history:witness && pnpm run check:style-coverage && pnpm run check:style-coverage:witness",
    "depcruise:witness": "depcruise tests/depcruise-witness --config tests/depcruise-witness/.dependency-cruiser.mjs --output-type err && (echo 'WITNESS DID NOT FIRE — the rule set is vacuous' && exit 1) || echo 'witness fired: rules are live'",
    "check:casts": "node tools/check-finalized-casts.ts",
    "check:casts:witness": "node tools/check-finalized-casts.ts --witness",
    "descriptors:generate": "node tools/check-descriptor-drift.ts --update",
    "test:mock-runtime": "node tools/run-suite.ts \"tests/mock-runtime/*.test.{js,ts}\"",
    "descriptors:check": "node tools/check-descriptor-drift.ts",
    "foreign:check": "node tools/check-foreign-feed.ts",
    "test:chain-client": "node tools/run-suite.ts \"tests/chain-client/*.test.{js,ts}\"",
    "surface:generate": "node tools/generate-critical-surface.ts",
    "surface:check": "node tools/generate-critical-surface.ts --check",
    "test:descriptors": "node tools/run-suite.ts \"tests/descriptors/*.test.{js,ts}\"",
    "check:budget": "node tools/check-smoldot-budget.ts",
    "check:bundle-budget": "node tools/check-bundle-budget.ts",
    "test:tx": "node tools/run-suite.ts \"tests/transaction-builder/*.test.{js,ts}\"",
    "test:verify": "node tools/run-suite.ts \"tests/verify/*.test.{js,ts}\"",
    "test:local-index": "node tools/run-suite.ts \"tests/local-index/*.test.{js,ts}\"",
    "test:analysis": "node tools/run-suite.ts \"tests/analysis/*.test.{js,ts}\"",
    "test:intents": "node tools/run-suite.ts \"tests/intents/*.test.{js,ts}\"",
    "test:contexts": "node tools/run-suite.ts \"tests/contexts/*.test.{js,ts}\"",
    "test:receipts": "node tools/run-suite.ts \"tests/receipts/*.test.{js,ts}\"",
    "check:handoff-network": "node tools/check-handoff-network.ts",
    "check:handoff-network:witness": "node tools/check-handoff-network.ts --witness",
    "test:release": "node tools/run-suite.ts --test-concurrency=1 \"tests/release/*.test.{js,ts}\"",
    "check:chain-literals": "node tools/check-chain-literals.ts",
    "check:chain-literals:witness": "node tools/check-chain-literals.ts --witness",
    "check:no-html-sinks": "node tools/check-no-html-sinks.ts",
    "check:no-html-sinks:witness": "node tools/check-no-html-sinks.ts --witness",
    "check:render-provenance": "node tools/check-render-provenance.ts",
    "check:render-provenance:witness": "node tools/check-render-provenance.ts --witness",
    "check:style-coverage": "node tools/check-style-coverage.ts",
    "check:style-coverage:witness": "node tools/check-style-coverage.ts --witness",
    "release:build": "node tools/release/build.ts",
    "release:check": "node tools/release/build.ts --check",
    "release:manifest": "node tools/release/repro-manifest.ts",
    "signers:audit": "node tools/verify-release/cli.ts signers audit",
    "test:llm-handoff": "node tools/run-suite.ts \"tests/llm-handoff/*.test.{js,ts}\"",
    "schemas:generate": "node tools/generate-schemas.ts --write",
    "schemas:check": "node tools/generate-schemas.ts",
    "skills:generate": "node tools/generate-skill-examples.ts --write && node tools/generate-skill-instructions.ts --write",
    "skills:check": "node tools/generate-skill-examples.ts && node tools/generate-skill-instructions.ts",
    "check:handoff-emitted": "node tools/check-handoff-emitted-imports.ts",
    "check:handoff-emitted:witness": "node tools/check-handoff-emitted-imports.ts --witness",
    "test:ui": "node tools/run-suite.ts \"tests/ui/*.test.{js,ts}\"",
    "test:screens": "node tools/run-suite.ts \"tests/screens/*.test.{js,ts}\"",
    "test:providers": "node tools/run-suite.ts \"tests/providers/*.test.{js,ts}\"",
    "check:above-fold": "node tools/check-above-fold-facts.ts",
    "check:types": "tsc -p tsconfig.tests.json",
    "check:smoldot-surface": "node tools/check-smoldot-surface.ts",
    "check:smoldot-surface:witness": "node tools/check-smoldot-surface.ts --witness",
    "test:snapshot-tool": "node tools/run-suite.ts \"tests/snapshot/*.test.{js,ts}\"",
    "test:platform": "node tools/run-suite.ts \"tests/platform/*.test.{js,ts}\"",
    "check:embedded-tree": "node tools/desktop/check-embedded-tree.ts",
    "check:embedded-tree:witness": "node tools/desktop/check-embedded-tree.ts --witness",
    "check:artifact-budget": "node tools/check-artifact-budget.ts",
    "test:budgets": "node tools/run-suite.ts \"tests/budgets/*.test.{js,ts}\"",
    "check:artifact-budget:witness": "node tools/check-artifact-budget.ts --witness",
    "check:render-budget": "node tools/render-budget/check.ts",
    "check:render-budget:witness": "node tools/render-budget/check.ts --witness",
    "check:provenance-mints": "node tools/check-provenance-mints.ts",
    "check:provenance-mints:witness": "node tools/check-provenance-mints.ts --witness",
    "check:covered-history": "node tools/check-covered-history.ts",
    "check:covered-history:witness": "node tools/check-covered-history.ts --witness"
  },
  "devDependencies": {
    "@polkadot-api/substrate-bindings": "0.20.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.12",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dependency-cruiser": "17.0.1",
    "esbuild": "0.28.1",
    "polkadot-api": "2.1.8",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  }
}
