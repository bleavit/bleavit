{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bleavit",
  "version": "0.0.0",
  "identifier": "org.bleavit.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bleavit",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
