# 12 §1.1: node-linker is part of the pinned build recipe, not left to the default.
# A hoisted layout resolves undeclared imports, which silently demotes the 10 §10.2
# firewall from a module-resolution failure to a tsc-only complaint. It also changes
# the sourcemap `sources` paths, which would break the two-environment tree-hash gate
# for a reason unrelated to the source.
node-linker=isolated
# Reproducibility: refuse to silently repair a lockfile that disagrees with the manifests.
frozen-lockfile=true
# Peer deps are declared, never auto-installed into the tree shape.
auto-install-peers=false
strict-peer-dependencies=false
