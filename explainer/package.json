{
  "name": "bleavit-explainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Educational explainer for the Bleavit futarchy protocol. NOT the canonical client (Track F).",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "fixtures": "node scripts/build-fixtures.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run fixtures -- --check && npm run math -- --check && npm run lint && npm run typecheck && npm test && vite build",
    "math": "node scripts/build-math.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@types/katex": "^0.16.7",
    "katex": "^0.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "jsdom": "30.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
